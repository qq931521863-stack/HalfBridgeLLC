Plecs {
  Name          "03_Gate_PWM"
  Version       "4.9"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      ".0001"
  Timeout       ""
  Solver        "radau"
  MaxStep       "1e-7"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "1"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "2"
  DatatypeInheritanceConflictMsg "1"
  ContSampleTimeConflictMsg "1"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "0"
  AlgebraicLoopWithStateMachineMsg "2"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands ""
  InitialState  "1"
  SystemState   ""
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "2"
  MatrixSignificanceCheck "2"
  RemoveUnusedStateSpaceOutputs "1"
  EnableStateSpaceSplitting "2"
  DisplayStateSpaceSplitting "1"
  DiscretizationMethod "2"
  ExternalModeSettings ""
  AlgebraicLoopMethod "1"
  AlgebraicLoopTolerance "1e-6"
  ScriptsDialogGeometry "[764 395 446 243]"
  ScriptsDialogSplitterPos "95"
  Terminal {
    Type          Output
    Index         "1"
  }
  Schematic {
    Location      [50, 50; 1400, 850]
    ZoomFactor    1.71498
    SliderPosition [0, 0]
    ShowBrowser   off
    BrowserWidth  100
    Component {
      Type          Constant
      Name          "Timer_frame"
      Show          on
      Position      [225, 150]
      Direction     right
      Flipped       off
      LabelPosition south
      Frame         [-10, -10; 10, 10]
      Parameter {
        Variable      "Value"
        Value         "[8500 1700 2550 5950 6800 0 0 0 0 1 1 0 1 1 0]"
        Show          off
      }
      Parameter {
        Variable      "DataType"
        Value         "10"
        Show          off
      }
    }
    Component {
      Type          CScript
      Name          "LLC_Gate"
      Show          on
      Position      [325, 150]
      Direction     up
      Flipped       off
      LabelPosition east
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "15"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "4"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "[25e-6,0;-2,0]"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include \"../gate/llc_gate_events.c\"\n"
"#include <float.h>\n"
"static LlcGate committed,candidate;"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "llcGateReset(&committed); llcGateReset(&candidate); Dis"
"cState(0)=0; NextSampleHit=DBL_MAX;"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double u[15],y[4],next; int k;\n"
"for(k=0;k<15;k++) u[k]=InputSignal(0,k);\n"
"if(!llcGateEvaluate(&committed,CurrentTime,IsSampleHit(0),u,&candidate,y,&nex"
"t)) SetErrorMessage(\"Invalid LLC timer frame\");\n"
"for(k=0;k<4;k++) OutputSignal(0,k)=y[k];\n"
"NextSampleHit=isfinite(next)?next:DBL_MAX;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "committed=candidate; DiscState(0)+=1;"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
    Component {
      Type          Output
      Name          "TC1_TC2_TD1_TD2"
      Show          on
      Position      [445, 150]
      Direction     right
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "Index"
        Value         "1"
        Show          on
      }
      Parameter {
        Variable      "Width"
        Value         "4"
        Show          off
      }
    }
    Connection {
      Type          Signal
      SrcComponent  "Timer_frame"
      SrcTerminal   1
      DstComponent  "LLC_Gate"
      DstTerminal   1
    }
    Connection {
      Type          Signal
      SrcComponent  "LLC_Gate"
      SrcTerminal   2
      DstComponent  "TC1_TC2_TD1_TD2"
      DstTerminal   1
    }
  }
}
