 Variable "RuntimeCheck"
 Value "2"
 Show off
 }
 Parameter {
 Variable "Declarations"
 Value "#include \"gate/llc_gate_events.c\"\n#include <float.h>\nstatic LlcGate committed,candidate;"
 Show off
 }
 Parameter {
 Variable "StartFcn"
 Value "llcGateReset(&committed); llcGateReset(&candidate); DiscState(0)=0; NextSampleHit=DBL_MAX;"
 Show off
 }
 Parameter {
 Variable "OutputFcn"
 Value "double u[15],y[4],next; int k;\nfor(k=0;k<15;k++) u[k]=InputSignal(0,k);\nif(!llcGateEvaluate(&committed,CurrentTime,IsSampleHit(0),u,&candidate,y,&next)) SetErrorMessage(\"Invalid LLC timer frame\");\nfor(k=0;k<4;k++) OutputSignal(0,k)=y[k];\nNextSampleHit=isfinite(next)?next:DBL_MAX;"
 Show off
 }
 Parameter {
 Variable "UpdateFcn"
 Value "committed=candidate; DiscState(0)+=1;"
 Show off
 }
 Parameter {
